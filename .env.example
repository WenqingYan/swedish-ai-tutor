# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
WHISPER_MODEL=gpt-4o-transcribe-diarize

# Notion
NOTION_API_KEY=secret_your-notion-integration-token
NOTION_PARENT_PAGE_ID=your-32-char-hex-page-id-here

# SR API (defaults are fine, override if needed)
# SR_PROGRAM_ID=4916
# SR_API_BASE=https://api.sr.se/api/v2

# Local settings
# DATA_DIR=./data
# DB_PATH=./data/vocabulary.db
# LOG_LEVEL=INFO
# WEB_SECURE_COOKIES=true  # Keep true for Tailscale HTTPS

# Learning settings
# MAX_NEWS=0          # 0 = all stories, 1/2/3 = randomly pick N stories per episode
